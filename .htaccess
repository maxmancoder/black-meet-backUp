# Protect sensitive files
<Files "config.json">
    Require all denied
</Files>
<Files "server.js">
    Require all denied
</Files>
<Files "package.json">
    Require all denied
</Files>
<Files "package-lock.json">
    Require all denied
</Files>
<Files ".env">
    Require all denied
</Files>
<Files ".env.example">
    Require all denied
</Files>
<Files "dev_otp.log">
    Require all denied
</Files>
<Files "node.log">
    Require all denied
</Files>
<Files "node.err">
    Require all denied
</Files>
<Files "turn_host.txt">
    Require all denied
</Files>
<Files "tunnel_url.txt">
    Require all denied
</Files>
<FilesMatch "\.ps1$">
    Require all denied
</FilesMatch>
<FilesMatch "\.bat$">
    Require all denied
</FilesMatch>
<FilesMatch "\.log$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.(sql|md|yaml|yml|cmd|lock)$">
    Require all denied
</FilesMatch>

# Block sensitive directories
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(sql|docker|tools|\.git)(/|$) - [F,L]
</IfModule>

# Protect config dir listings
Options -Indexes

# Uploaded avatars: block script execution via FilesMatch (no <Directory> allowed in .htaccess)
# NOTE: never use php_flag engine off here — .htaccess scope covers the whole tree.
<FilesMatch "^uploads/.*\.(php|phtml|phar|php3|php4|php5|php7|phps|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>
